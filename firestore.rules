rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Validate minimum 8-digit international / national phone number
    function isValidPhone(phone) {
      return phone is string && phone.size() >= 8;
    }

    // 1. Campaign Aggregates (Grand Total & Live Counter)
    // Public can read, authenticated client can increment/sync
    match /campaignAggregates/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Offers (Donor Pledges)
    // Public can submit an offer with validated fields (name, phone, amount)
    // Public can read for live updates and receipt lookup
    match /offers/{offerId} {
      allow read: if true;
      allow create: if request.resource.data.contributorName is string
                    && isValidPhone(request.resource.data.contributorPhone)
                    && request.resource.data.totalOfferedPaise is number
                    && request.resource.data.totalOfferedPaise > 0;
      allow update, delete: if true;
    }

    // 3. Cash Collections (Counter & Venue Collections)
    // Volunteers and Admin record cash entries, public/receipt can read
    match /cashCollections/{cashId} {
      allow read: if true;
      allow create: if request.resource.data.amountPaise is number
                    && request.resource.data.amountPaise > 0
                    && (
                      isValidPhone(request.resource.data.contributorPhone)
                      || request.resource.data.hasNoPhone == true
                    );
      allow update, delete: if true;
    }

    // 4. Venue Events (Live Screen & Venue QR codes)
    // Public can read event stats, Admin can create/update
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Public Announcements for Live Screen
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Volunteers (Staff PIN Authentication & POS Staff)
    // Synchronized across all devices in real-time
    match /volunteers/{volunteerId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. System & Payment Settings (Merchant UPI ID, QR setup)
    // Public can read merchant UPI ID and QR config; Admin saves settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Direct Merchant UPI Payments
    // Public can read payment slips and verification status
    // Initiation requires a valid positive expected amount in Paise
    // Contributors can update UTR submissions, Admins update verification statuses
    // Deletion is strictly prevented to preserve audit trail
    match /payments/{paymentId} {
      allow read: if true;
      allow create: if request.resource.data.expectedAmountPaise is number
                    && request.resource.data.expectedAmountPaise > 0;
      allow update: if true;
      allow delete: if false;
    }

    // 9. UTR Registry (Duplicate UTR prevention in atomic transactions)
    // Used in Firestore transactions to verify uniqueness and register UTRs
    match /utrRegistry/{utr} {
      allow read, write: if true;
    }

    // Deny all other collections by default for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
